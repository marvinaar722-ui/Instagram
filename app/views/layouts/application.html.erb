<!DOCTYPE html>
<html lang="es">
<head>
  <title>Instagram</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body style="padding-top: 70px;">
  <nav class="navbar navbar-dark bg-dark fixed-top">
    <div class="container">
      <%= link_to "Instagram", root_path, class: "navbar-brand" %>
      <ul class="navbar-nav flex-row gap-3">
        <li><%= link_to "New Post", new_post_path, class: "nav-link" %></li>
        <% if user_signed_in? %>
          <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link nav-link" %></li>
        <% else %>
          <li><%= link_to "Login", new_user_session_path, class: "nav-link" %></li>
          <li><%= link_to "Register", new_user_registration_path, class: "nav-link" %></li>
        <% end %>
      </ul>
    </div>
  </nav>

  <div class="container text-center">
    <% flash.each do |tipo, mensaje| %>
      <div class="alert alert-success"><%= Array(mensaje).join(", ") %></div>
    <% end %>
    <%= yield %>
  </div>
</body>
</html>
