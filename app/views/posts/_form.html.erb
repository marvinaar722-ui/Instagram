<%= form_with model: post do |f| %>
  <div class="mb-3">
    <%= f.label :image %>
    <%= f.file_field :image, accept: "image/*", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :description %>
    <%= f.text_area :description, class: "form-control" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
